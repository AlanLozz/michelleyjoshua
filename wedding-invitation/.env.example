# Google Apps Script URL para el formulario de confirmación
# Obtén esta URL siguiendo las instrucciones en CONFIGURACION_GOOGLE_SHEETS.md
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/TU_ID_AQUI/exec

# Token secreto para seguridad del formulario
# Genera uno aleatorio en: https://www.uuidgenerator.net/
# IMPORTANTE: Debe ser el mismo token que configuraste en Google Apps Script
VITE_FORM_SECRET_TOKEN=tu-token-secreto-aleatorio-aqui

# Hash de contraseña para acceso al panel de administración
# Para generar el hash de tu contraseña:
# 1. Abre la consola de desarrollador del navegador (F12)
# 2. Pega este código y reemplaza "TU_CONTRASEÑA" con tu contraseña deseada:
#    let hash = 0; const pwd = "TU_CONTRASEÑA"; for(let i = 0; i < pwd.length; i++) { const char = pwd.charCodeAt(i); hash = ((hash << 5) - hash) + char; hash = hash & hash; } console.log(hash.toString());
# 3. Copia el número que aparece y pégalo aquí
VITE_ADMIN_PASSWORD_HASH=tu-hash-de-contraseña-aqui
